# Get a free groq api key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Path to the ticket CSV (defaults to data/support_tickets.csv if unset)
TICKETS_CSV_PATH=data/support_tickets.csv

# Used only by the Streamlit UI to reach the FastAPI backend
API_BASE_URL=http://localhost:8000
